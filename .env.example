# Public origin used for canonical URLs, Open Graph images, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Form emails (Feedback and Join YouthLink) are sent through Brevo's transactional email API.
# API key: Brevo → SMTP & API → API keys. Never commit the real key.
BREVO_API_KEY=
# Where submissions are delivered (comma-separate several addresses).
FORM_TO_EMAIL=websitedataylsc@gmail.com
# Sender shown on the email; must be a verified sender/domain in Brevo (Senders, Domains & IPs).
FORM_FROM_EMAIL=contact@youthlinkpakistan.com
FORM_FROM_NAME=YouthlinkPakistan

# Neon Postgres: form submissions are also saved here. Use the *pooled* connection string
# (Neon → Connect). Create the tables once with `npm run db:setup`.
DATABASE_URL=
