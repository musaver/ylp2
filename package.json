{
  "name": "youthlink",
  "version": "2.0.0",
  "private": true,
  "description": "YouthLink \u2014 community & nonprofit website built with Next.js, TypeScript and Tailwind CSS.",
  "scripts": {
    "dev": "node init && next dev",
    "build": "node init && next build",
    "start": "node init && next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "typescript": "^5"
  }
}
